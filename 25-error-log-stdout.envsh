#!/bin/sh
# Sourced by the official nginx entrypoint before the server starts.
#
# nginx writes its whole error log -- including start-up notices such as
# "start worker process 92" -- to /dev/stderr, which container platforms (Railway
# included) surface as error lines. Access logs already go to stdout; send the
# error log there too so the container emits one stream with real severities
# instead of a false error report on every start.
set -eu

conf=/etc/nginx/nginx.conf
if grep -q '^error_log  */var/log/nginx/error.log' "$conf"; then
    sed -i 's#^error_log  */var/log/nginx/error.log.*#error_log  /dev/stdout notice;#' "$conf"
fi
