upstream api_backend {
    zone api_backend 64k;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=5s;
    resolver_timeout 5s;
    server ${API_UPSTREAM_ADDRESS} resolve;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/internal/ {
        return 404;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM_SCHEME}://api_backend/;
        proxy_set_header Host ${API_UPSTREAM_HOST};
        proxy_ssl_server_name on;
        proxy_ssl_name ${API_UPSTREAM_NAME};
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
    }

    # index.html names the hashed bundles, so it must never outlive a deploy in a
    # browser's heuristic cache: revalidate it (cheap 304 via ETag) on every load.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # Assets carry a content hash in their name, so a given URL never changes.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Client-side routes all render index.html, so they inherit its freshness rule.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }
}

# Old bundles and bookmarks still call the retired API host. Answer them at the
# edge of this container so they reload the current dashboard instead of writing
# to the legacy backend, which no longer owns accounts.
server {
    listen 80;
    listen [::]:80;
    server_name api.ronnia.me;
    return 308 https://ronnia.me$request_uri;
}
